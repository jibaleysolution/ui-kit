{
    "name": "@jibaleysolution/ui",
    "version": "0.2.1",
    "description": "Jibaley ecosystem design system — Vue 3 + Inertia + reka-ui + Tailwind 4 admin-panel kit",
    "type": "module",
    "license": "MIT",
    "author": "Jibaley <engineering@jibaley.com>",
    "homepage": "https://jibaleysolution.github.io/ui-kit/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jibaleysolution/ui-kit.git"
    },
    "bugs": {
        "url": "https://github.com/jibaleysolution/ui-kit/issues",
        "email": "engineering@jibaley.com"
    },
    "keywords": [
        "vue",
        "vue3",
        "inertia",
        "reka-ui",
        "tailwindcss",
        "design-system",
        "component-library",
        "ui-kit",
        "admin",
        "rtl"
    ],
    "bin": {
        "jibaley-ui": "./bin/init.mjs"
    },
    "files": [
        "dist",
        "theme.css",
        "bin",
        "skills",
        "AGENTS.md",
        "CLAUDE.md",
        "llms.txt"
    ],
    "sideEffects": [
        "*.css"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./theme.css": "./theme.css",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vite build",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "play": "vite --config playground/vite.config.ts",
        "build:play": "vite build --config playground/vite.config.ts",
        "prepublishOnly": "npm run typecheck && npm run test && npm run build"
    },
    "peerDependencies": {
        "@inertiajs/vue3": "^2.0.0",
        "@lucide/vue": "^1.25.0",
        "reka-ui": "^2.10.0",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^2.3.27",
        "@lucide/vue": "^1.25.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.4.11",
        "jsdom": "^29.1.1",
        "reka-ui": "^2.10.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^8.0.0",
        "vite-plugin-dts": "^4.5.0",
        "vitest": "^4.1.10",
        "vue": "^3.5.40",
        "vue-tsc": "^3.3.7"
    }
}
